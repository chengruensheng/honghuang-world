# 密钥与环境
.env

# 构建产物（道果树维度；质量门禁-域 为源码工具白名单，不入忽略）
道果树/*
!道果树/质量门禁-域/
!道果树/质量门禁-域/**

# 运行时记忆数据
.上下文/

# 临时
临时文件夹/

# IDE/工具本地配置
.arts/
.merkle-snapshot.json
.vscode/
.idea/
.codegraph/
# trae agent 工具产物（旧架构 §11.7 删除前的 pre-termination 备份，新仓库不收）
.trae-html-share-packages/

# 观测探针-府根目录脏落点（§十 2026-08-25 修正：观测数据统一在 .上下文/观测/）
观测/

# 工具本地配置(CodeArts/智能体工具)
.codeartsdoer/

# 空目录(违反六层规范, 源码按 维度/域/府/殿/阁/园 分布, 不在根放 src/tests/scripts)
/src/
/tests/
/scripts/

__pycache__/
*.pyc

# 测试与运行输出日志（运行日志含完整提示词，严禁入库）
*.log
