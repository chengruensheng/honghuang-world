/target/
**/target/
/道果/
.env
.env.local
*.key

# AI 工具与索引目录（非项目代码）
/.codeartsdoer/
/.codegraph/
/.workbuddy/
/.merkle-snapshot.json

# 实验脚本临时物（英文命名，非项目 Rust 代码）
/_memory_experiment/

# 本地运行日志（每次启动生成，非项目代码）
/启动日志.txt
/启动错误.txt
/验收测试结果.txt
/验收测试结果2.txt
/验收测试结果3.txt

# 本机 AI 协作与记忆（非项目代码，避免跨机漂移）
/.codebuddy/
/.cache/
/tmp/
/.trae/

# .传承/ 记忆区=运行状态（规范 §二/§七：源进 git，状态忽略）
/.传承/记忆/**
!/.传承/记忆/.gitkeep

# 运行时工作区沙箱（智能体/看板驱动落盘产物：target、验收截图、Cargo.lock、.bak 等，不入库）
/工作区/

# 前端依赖（npm install 产物，不入库）
node_modules/

# 本地运行日志（各工具落盘，非项目源码）
*.log
